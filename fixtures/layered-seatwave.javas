//// The same confirm as the modular monolith, arranged by technical layer the way the tangle grew:
//// one model shared by every service, every repository reading any table of the one schema.
//// The course's capture script splits this bundle at each FILE line into a source tree and compiles it.
//// FILE: io/plainround/seatwave/layered/model/Hold.java
package io.plainround.seatwave.layered.model;

import java.time.Instant;
import java.util.UUID;

/** A hold row, shared by every service that needs one. */
public record Hold(UUID holdId, long eventId, String seatLabel, long customerId, String state,
    Instant expiresAt) {

  /** The hold rule: a fan may pay only for an ACTIVE hold that has not expired. */
  public boolean canBePaidAt(Instant now) {
    return "ACTIVE".equals(state) && expiresAt.isAfter(now);
  }
}
